# Copy this file to .env for local use. Do not commit .env or real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
MAIL_FROM=sender@example.com
MAIL_TO=recipient1@example.com,recipient2@example.com
MAIL_SUBJECT=定时邮件

# Use one transport mode only: STARTTLS (normally port 587) or SSL (normally port 465).
SMTP_USE_SSL=false
SMTP_STARTTLS=true
